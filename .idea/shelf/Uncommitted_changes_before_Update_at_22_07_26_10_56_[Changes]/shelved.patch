+    public static QuestLog createDefaultQuests() {
+        QuestLog log = new QuestLog();
+
+        // 1. Daily Sun Catcher (3000, 4000, 5000)
+        for (int amount : new int[]{3000, 4000, 5000}) {
+            Quest q = new Quest("daily_sun_catcher_" + amount, "Daily Sun Catcher",
