+        public Builder(String alias, String objClass) {
+            this.alias = alias;
+            this.objClass = objClass;
+        }
+
+        public Builder hitPoints(float v)                { hitPoints = v; return this; }
+        public Builder eatDps(float v)                   { eatDps = v; return this; }
