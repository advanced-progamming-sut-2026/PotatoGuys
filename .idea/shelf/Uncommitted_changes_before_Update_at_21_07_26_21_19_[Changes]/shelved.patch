-
-    // ── Loading ───────────────────────────────────────────────────────────────
-
-    private void load() {
-        RootDto root = SaveManager.getInstance().loadAbsolute(Constants.ZOMBIE_PROFILES_PATH, RootDto.class);
-        if (root == null) {
-            System.err.println("[ZombieRegistry] zombie_profiles.json could not be loaded; "
-                    + "no zombies will be available.");
