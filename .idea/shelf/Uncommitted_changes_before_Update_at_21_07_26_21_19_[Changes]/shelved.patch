-        int cols = map.getColumns();
-        for (int r = 0; r < rows; r++) {
-            for (int c = 0; c < cols / 2; c++) {
-                String left = getPlantTypeAt(map, c, r);
-                String right = getPlantTypeAt(map, cols - 1 - c, r);
