-            return switch (vase.type) {
-                case PLANT -> " P? ";
-                case GARGANTUAR -> " G? ";
-                default -> " ?? ";
-            };
-        }
-
-        // ۲. اگر کوزه شکسته یا وجود نداشت، وضعیت گیاه‌/زامبی روی خانه را رسم کن
